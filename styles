/* Основные стили */
body {
  font-family: 'Cinzel', serif;
  background-color: #1a1a1a;
  color: #e0e0e0;
  margin: 0;
  padding: 0;
  line-height: 1.6;
}

.container {
  width: 90%;
  max-width: 1200px;
  margin: 0 auto;
}

/* Заголовок */
header {
  background: url('gothic-bg.jpg') no-repeat center center/cover;
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  color: #fff;
}

header h1 {
  font-size: 4rem;
  margin: 0;
  text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.7);
}

header p {
  font-size: 1.5rem;
  text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.7);
}

/* Секции */
section {
  padding: 60px 0;
}

h2 {
  font-size: 2.5rem;
  color: #c0a062;
  text-align: center;
  margin-bottom: 40px;
}

/* Возможности */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 20px;
}

.feature {
  background: #2a2a2a;
  padding: 20px;
  border-radius: 10px;
  text-align: center;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
}

.feature h3 {
  color: #c0a062;
  font-size: 1.8rem;
}

/* Форма */
form {
  display: flex;
  flex-direction: column;
  gap: 15px;
  max-width: 600px;
  margin: 0 auto;
}

input, textarea {
  padding: 10px;
  border: 1px solid #444;
  border-radius: 5px;
  background: #2a2a2a;
  color: #e0e0e0;
  font-family: 'Cinzel', serif;
}

button {
  padding: 10px 20px;
  background: #c0a062;
  border: none;
  border-radius: 5px;
  color: #1a1a1a;
  font-family: 'Cinzel', serif;
  cursor: pointer;
  transition: background 0.3s;
}

button:hover {
  background: #a08042;
}

/* Футер */
footer {
  background: #111;
  padding: 20px 0;
  text-align: center;
  margin-top: 60px;
}

footer p {
  margin: 0;
  color: #666;
}